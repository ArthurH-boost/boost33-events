# Names only. Values live in Vercel, never in this repo.

# ── Identity (sign-in) ───────────────────────────────────────────────────────
# Where Identity lives. Default: https://id.boost33.com (also read as BOOST33_IDENTITY_URL)
B33_ID_URL=
# This app's public URL: the `return` link sent to Identity at sign-in.
APP_URL=
# "Back to the Hub" link. Default: https://app.boost33.com/
NEXT_PUBLIC_HUB_URL=

# ── Database: Supabase project "boost33-brokers" (shared with Off Market / Results) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Settings → API → JWT Secret. Signs a one-minute service token per call. (also read as SUPABASE_JWT_KEY)
SUPABASE_JWT_SECRET=

# ── Map and geocoding (maptiler.com, free tier) ─────────────────────────────
NEXT_PUBLIC_MAPTILER_KEY=

# ── Push emails ──────────────────────────────────────────────────────────────
RESEND_API_KEY=
# Default: Boost33 Events <events@boost33.com> (the domain must be verified in Resend)
MAIL_FROM=
# Vercel sets this itself for cron calls; any random string of 16+ characters.
CRON_SECRET=

# ── The Hub's mini-map ───────────────────────────────────────────────────────
# Shared secret the Hub sends as `Authorization: Bearer` to /api/hub-widget.
HUB_WIDGET_KEY=

# ── Who may publish and reject (besides Boost33 staff) ──────────────────────
ADMIN_EMAILS=arthur@boost33.com

# ── Local development only (ignored on Vercel production) ────────────────────
# Default simulated person: sales | broker | client
EVENTS_DEV_SESSION=client

# ── Error tracking ───────────────────────────────────────────────────────────
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
